{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs"],
            "timeout": 10,
            "statusMessage": "Esquisse : vérification des maquettes validées..."
          }
        ]
      }
    ]
  }
}
